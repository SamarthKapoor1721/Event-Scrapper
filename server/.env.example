# Optional AI fallback (only used when HTML parsing confidence is low).
# Leave unset for normal operation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# LinkedIn Profile Discovery is FREE by default — it searches Brave/Ecosia/Bing/
# Startpage through the bundled headless browser and needs no key.
#
# Optional: set BRAVE_API_KEY for the official Brave Search API (free tier:
# ~2,000 queries/month, no card). It's more reliable from a deployed server
# (datacenter IPs get blocked by keyless scraping) and is used in preference to
# the keyless browser search when present. Get a key at https://brave.com/search/api
BRAVE_API_KEY=

# Google Programmable Search (Custom Search JSON API) — FREE, no credit card,
# 100 queries/day, and NEVER shows a CAPTCHA. The most reliable free option.
# Setup: create a key at https://developers.google.com/custom-search/v1/overview
# and a search engine (set to search the whole web) at https://programmablesearchengine.google.com
# Then paste the API key and the Search-engine ID (cx) below.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Show a VISIBLE browser so you can solve a CAPTCHA by hand once (it's remembered).
# HEADFUL=1

# Server port (default 4000).
PORT=4000
