{
  "manifest_version": 3,
  "name": "EventScout LinkedIn Collector",
  "version": "1.0.0",
  "description": "Collect LinkedIn profiles from search results and profile pages, and send them to your EventScout app.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EventScout Collector"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
